# Personal bank statements — never commit
bank_data_examples_do_not_share/

# Local scratch work
scratch-workspace/

# Local agent settings and working artefacts. Plans and specs are how a change
# was arrived at, not what it produced — the code, the tests and the reference
# docs are that. They stay on disk and out of the repository.
.claude/
docs/superpowers/

# Uploaded user files (statements, photos, documents) — live on the data volume
data/

# Dependencies and build output
node_modules/
.svelte-kit/
build/
dist/
.output/
.vercel/
.netlify/
.wrangler/

# Environment and secrets
.env
.env.*
!.env.example
!.env.test

# Test artifacts
coverage/
test-results/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Session tooling
.remember/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# OCR language data — fetched at build time, never committed
tessdata/
# The directory rule above does not match a model downloaded to the repo
# root, which is how four of them entered the history once.
*.traineddata
*.traineddata.gz
