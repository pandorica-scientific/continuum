{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/data/**",
              "components/shell/**",
              "ui_kits/continuum-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Variable|Source Code Pro))/i]",
        "message": "Font not provided by the design system. Available: Inter Variable, Source Code Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccountRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|name|numbers|meta|balance|baseEquivalent|first|key|ref|className|style|children)$/]",
        "message": "<AccountRow> doesn't accept that prop. Declared props: emoji, name, numbers, meta, balance, baseEquivalent, first."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionError'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|style|key|ref|className|style|children)$/]",
        "message": "<ActionError> doesn't accept that prop. Declared props: message, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|withWordmark|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: size, withWordmark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BriefingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|icon|pill|hue|title|body|style|key|ref|className|style|children)$/]",
        "message": "<BriefingCard> doesn't accept that prop. Declared props: kind, icon, pill, hue, title, body, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BriefingCard'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:green|yellow|red|blue|teal|purple|grey)$/]",
        "message": "<BriefingCard> hue must be one of 'green' | 'yellow' | 'red' | 'blue' | 'teal' | 'purple' | 'grey'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|disabled|onClick|type|href|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, disabled, onClick, type, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Doc'] > JSXAttribute > JSXIdentifier[name!=/^(?:ext|name|shelf|when|tone|restricted|key|ref|className|style|children)$/]",
        "message": "<Doc> doesn't accept that prop. Declared props: ext, name, shelf, when, tone, restricted."
      },
      {
        "selector": "JSXOpeningElement[name.name='Doc'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:past|soon|quiet)$/]",
        "message": "<Doc> tone must be one of 'past' | 'soon' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:emoji|icon|label|caption|right|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: emoji, icon, label, caption, right, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|style|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoHint'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|side|key|ref|className|style|children)$/]",
        "message": "<InfoHint> doesn't accept that prop. Declared props: label, children, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoHint'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<InfoHint> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListPager'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|pages|range|onChange|bare|key|ref|className|style|children)$/]",
        "message": "<ListPager> doesn't accept that prop. Declared props: page, pages, range, onChange, bare."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|note|color|style|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, value, unit, note, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onClose|children|titleAside|inline|width|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, onClose, children, titleAside, inline, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|icon|href|customising|fit|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, icon, href, customising, fit, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PersonTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|compact|key|ref|className|style|children)$/]",
        "message": "<PersonTag> doesn't accept that prop. Declared props: name, hue, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:hue|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: hue, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuickAdd'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|open|fixed|style|key|ref|className|style|children)$/]",
        "message": "<QuickAdd> doesn't accept that prop. Declared props: items, open, fixed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RateBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:currencies|onDismiss|children|style|key|ref|className|style|children)$/]",
        "message": "<RateBanner> doesn't accept that prop. Declared props: currencies, onDismiss, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|caption|icon|hue|syncedAt|actions|tabs|activeTab|onTab|key|ref|className|style|children)$/]",
        "message": "<ScreenHeader> doesn't accept that prop. Declared props: title, caption, icon, hue, syncedAt, actions, tabs, activeTab, onTab."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreenHeader'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:brand|teal|purple|blue|orange|indigo|fg3)$/]",
        "message": "<ScreenHeader> hue must be one of 'brand' | 'teal' | 'purple' | 'blue' | 'orange' | 'indigo' | 'fg3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Area'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|hue|key|ref|className|style|children)$/]",
        "message": "<Area> doesn't accept that prop. Declared props: key, label, icon, hue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Area'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:brand|teal|purple|blue|orange|indigo|fg3)$/]",
        "message": "<Area> hue must be one of 'brand' | 'teal' | 'purple' | 'blue' | 'orange' | 'indigo' | 'fg3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Txn'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|merchant|detail|account|amount|negative|categoryLabel|categoryToken|reviewState|isSplit|isTransfer|loanPayment|documents|tags|key|ref|className|style|children)$/]",
        "message": "<Txn> doesn't accept that prop. Declared props: date, merchant, detail, account, amount, negative, categoryLabel, categoryToken, reviewState, isSplit, isTransfer, loanPayment, documents, tags."
      },
      {
        "selector": "JSXOpeningElement[name.name='Txn'] > JSXAttribute[name.name='reviewState'] > Literal[value!=/^(?:auto|needs_review|confirmed)$/]",
        "message": "<Txn> reviewState must be one of 'auto' | 'needs_review' | 'confirmed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UploadDropzone'] > JSXAttribute > JSXIdentifier[name!=/^(?:idleText|busy|busyText|showCapture|onFiles|style|key|ref|className|style|children)$/]",
        "message": "<UploadDropzone> doesn't accept that prop. Declared props: idleText, busy, busyText, showCapture, onFiles, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
