#!/bin/sh
# Keep the files that name a version in step with package.json.
#
# Convenience, not enforcement: a hook only exists in a clone where someone ran
# `npm install`, so CI checks the same rule with the same script. This just
# means you rarely see CI catch it.
#
# Anything the sync rewrites is re-staged, so the commit contains the corrected
# file rather than leaving it dirty in the working tree — a hook that fixes a
# file and then commits the unfixed version is worse than no hook.
#
# `git commit --no-verify` skips it.
set -e

# A GUI git client does not run a login shell, so it inherits a bare PATH with
# no Homebrew, nvm or fnm on it. The hook used to die on `node: command not
# found` and take the commit with it — enforcement, from a hook that says two
# lines up that it is not one.
if ! command -v node >/dev/null 2>&1; then
  # Fixed locations first. The version managers are globbed rather than read
  # from .nvmrc: that file holds "20" while the directory is "v20.11.0", so
  # composing a path out of it finds nothing.
  for candidate in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    "$HOME/.volta/bin/node" \
    "$HOME/.local/share/fnm/aliases/default/bin/node" \
    "$HOME"/.nvm/versions/node/*/bin/node; do
    if [ -x "$candidate" ]; then
      PATH="$(dirname "$candidate"):$PATH"
      export PATH
      break
    fi
  done
fi

# nvm and fnm install per-version with no stable path, so a lookup can still
# come up empty. Say so and stand aside: CI runs `version:check` on the same
# script, which is where this rule is actually enforced.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: no node on PATH, skipping the version sync — CI still checks it." >&2
  exit 0
fi

CHANGED=$(node scripts/sync-version.mjs)
if [ -n "$CHANGED" ]; then
  printf '%s\n' "$CHANGED"
  # Only re-stage what was ALREADY part of this commit. Sweeping in a file the
  # author deliberately left unstaged would be the hook deciding what the
  # commit contains.
  for f in package-lock.json docs/install.md; do
    if ! git diff --quiet -- "$f" && ! git diff --cached --quiet -- "$f"; then
      git add "$f"
      echo "pre-commit: re-staged $f"
    fi
  done
fi
