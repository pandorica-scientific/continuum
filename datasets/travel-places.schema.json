{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worldwide travel places 1.0.0",
  "type": "object",
  "required": [
    "metadata",
    "countries"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object"
    },
    "countries": {
      "type": "array",
      "minItems": 195,
      "items": {
        "$ref": "#/$defs/country"
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "name",
        "nameLanguage",
        "country",
        "countryId",
        "iconPath",
        "countryCode",
        "region",
        "regionCode",
        "regionStatus",
        "type",
        "latitude",
        "longitude",
        "importance",
        "tourismTags",
        "alternateNames",
        "wikidataId",
        "geographyMethod",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nameLanguage": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "countryId": {
          "type": "string",
          "minLength": 1
        },
        "iconPath": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionStatus": {
          "enum": [
            "assigned",
            "unresolved",
            "no_subdivision"
          ]
        },
        "type": {
          "enum": [
            "city",
            "town",
            "village",
            "landmark",
            "natural_landmark",
            "national_park",
            "island",
            "beach",
            "mountain",
            "lake",
            "archaeological_site",
            "religious_site",
            "museum",
            "historic_site"
          ]
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "tourismTags": {
          "type": "array",
          "items": {
            "enum": [
              "archaeology",
              "architecture",
              "art",
              "beaches",
              "coast",
              "culture",
              "heritage",
              "hiking",
              "history",
              "islands",
              "museums",
              "nature",
              "outdoors",
              "pilgrimage",
              "religion",
              "sightseeing",
              "unesco",
              "urban",
              "water",
              "wildlife"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "alternateNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "wikidataId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^Q[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "geographyMethod": {
          "enum": [
            "polygon",
            "coastal-nearest",
            "geonames",
            "source-corrected"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source",
              "url"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": [
        "name",
        "regionCode",
        "status",
        "places"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "regionCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "assigned",
            "unresolved",
            "no_subdivision"
          ]
        },
        "places": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/place"
          }
        }
      }
    },
    "country": {
      "type": "object",
      "required": [
        "id",
        "name",
        "countryCode",
        "status",
        "regions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "sovereign",
            "associated_state",
            "separately_administered",
            "territory_or_special_area"
          ]
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/region"
          }
        }
      }
    }
  }
}
