# Copy to .env for local development. In Docker these come from docker-compose.yml.

# Postgres connection string
DATABASE_URL=postgres://continuum:continuum@localhost:5432/continuum

# The ONE https address passkeys are bound to. Optional.
#
# It no longer decides whether a form submission is accepted: that is checked
# against the address your browser actually used, so the app works at every
# address it answers on — localhost, a LAN IP, continuum.local, a tailnet name.
#
# A passkey, though, is bound to exactly one hostname by the browser, so this
# names which one. Leave it unset and password sign-in works everywhere with no
# passkey controls anywhere; set it and passkeys additionally work at that
# address. It must match what you browse to exactly — it is normalised, but a
# different host or scheme will not verify.
# ORIGIN=https://continuum.your-tailnet.ts.net

# Household security policy. Both are optional; these are the defaults.
# PASSWORD_MIN_LENGTH=8
# ENROLLMENT_LINK_DAYS=7

# The Tailscale sidecar in compose.yaml runs by default; it is what gives the
# app HTTPS, and passkeys need HTTPS. Leave this unset to authenticate the
# sidecar interactively (`docker compose logs tailscale` prints a login URL), or
# put an auth key here to have it join the tailnet unattended. Either way, point
# ORIGIN above at the https://…ts.net name once Tailscale issues it.
# TS_AUTHKEY=tskey-auth-…

# Behind a reverse proxy (the tailscale sidecar in compose.yaml, or your own),
# every request reaches the app from the proxy, so the sign-in rate limiter
# sees the whole household as one caller. These make the app read the real
# client address from the forwarded header instead.
#
# Set them ONLY when a trusted proxy is the only way in and it always
# overwrites the header. If anything can reach the app directly, a caller can
# forge the header and step around the limiter entirely — which is why this is
# off by default rather than guessed.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
