# Copy to .env for local development. In Docker these come from docker-compose.yml.

# Postgres connection string
DATABASE_URL=postgres://continuum:continuum@localhost:5432/continuum

# Public origin the app is served from (needed for correct CSRF and cookies).
# Also the relying party for passkeys, so it must match the address you browse
# to exactly — it is normalised, but a different host or scheme will not verify.
ORIGIN=http://localhost:5173

# Household security policy. Both are optional; these are the defaults.
# PASSWORD_MIN_LENGTH=8
# ENROLLMENT_LINK_DAYS=7

# Behind a reverse proxy (the tailscale profile in compose.yaml, or your own),
# every request reaches the app from the proxy, so the sign-in rate limiter
# sees the whole household as one caller. These make the app read the real
# client address from the forwarded header instead.
#
# Set them ONLY when a trusted proxy is the only way in and it always
# overwrites the header. If anything can reach the app directly, a caller can
# forge the header and step around the limiter entirely — which is why this is
# off by default rather than guessed.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1
