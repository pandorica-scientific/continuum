# Everything here is optional. Copy to .env next to compose.yaml only if you
# need to change one of these; a normal install needs nothing but TS_AUTHKEY,
# which can be given on the command line instead:
#
#   TS_AUTHKEY=tskey-auth-… docker compose up -d

# Tailscale auth key, from https://login.tailscale.com/admin/settings/keys.
# Joins the sidecar to your tailnet unattended. Leave unset to sign in by
# hand instead: `docker compose logs tailscale` prints a login URL.
# TS_AUTHKEY=tskey-auth-…

# Host port for plain http on the local network, if 80 is taken.
# CONTINUUM_PORT=80

# Where backups are written. A cloud-synced folder on the host carries them
# off-machine.
# CONTINUUM_BACKUPS=/Users/you/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive

# Largest accepted upload.
# CONTINUUM_MAX_UPLOAD=32M

# Database password. Read only on the very first start — see docs/install.md
# before changing it on an instance that already has data.
# POSTGRES_PASSWORD=continuum

# Seed a fictional household on a pristine instance.
# DEMO=1

# Household security policy; these are the defaults.
# PASSWORD_MIN_LENGTH=8
# ENROLLMENT_LINK_DAYS=7

# --- Only if you terminate TLS yourself instead of using the sidecar -------

# The one https address passkeys are bound to. Discovered from the Tailscale
# sidecar automatically; set it only behind your own reverse proxy, and to
# exactly the address you browse to.
# ORIGIN=https://ledger.example.com

# Read the real client address from your proxy's forwarded header, so the
# sign-in rate limiter counts callers rather than the proxy. Set ONLY when that
# proxy is the only way in and always overwrites the header; otherwise anyone
# who can reach the app directly can forge it and step around the limiter.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# --- Local development (npm run dev) ---------------------------------------
DATABASE_URL=postgres://continuum:continuum@localhost:5432/continuum
